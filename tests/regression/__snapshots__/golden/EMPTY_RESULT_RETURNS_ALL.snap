    "findings": {
      "added": [
        {
          "check": "filter.empty-in",
          "detail": "emptyIn=match-none but id.in.() returned 17 record(s) — the unfiltered set, so the filter was ignored.",
          "entity": "table",
          "operations": [
            "table.list"
          ],
          "evidence": [
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_alpha/tables?limit=100"
            },
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_alpha/tables?limit=100&filter=id.in.%28%29"
            }
          ],
          "summary": "empty in() did not match none",
          "verdict": "BACKEND_BUG"
        },
        {
          "check": "filter.like-metacharacters-escaped",
          "detail": "filter=label.like.%25 matched all 7 records. \"%\" is a literal in this grammar; treating it as a wildcard means user input is being interpolated into a pattern unescaped.",
          "entity": "row",
          "operations": [
            "row.list"
          ],
          "evidence": [
            {
