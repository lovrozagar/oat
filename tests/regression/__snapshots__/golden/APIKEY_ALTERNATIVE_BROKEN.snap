    "findings": {
      "added": [
        {
          "check": "auth.alternative-accepted",
          "detail": "job.get answered 401 to alpha's apiKey credential, though the document accepts apiKey with job:read on its own. The same request with jwt answered 200.",
          "entity": "job.get",
          "operations": [
            "job.get"
          ],
          "evidence": [
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_alpha/jobs/job_ID"
            },
            {
              "method": "GET",
              "status": 401,
              "url": "http://reference.test/v1/projects/proj_alpha/jobs/job_ID"
            }
          ],
          "summary": "an operation refused a credential one of its documented alternatives accepts",
          "verdict": "BACKEND_BUG"
        },
        {
          "check": "auth.alternative-accepted",
          "detail": "job.list answered 401 to alpha's apiKey credential, though the document accepts apiKey with job:read on its own. The same request with jwt answered 200.",
          "entity": "job.list",
          "operations": [
            "job.list"
          ],
          "evidence": [
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_alpha/jobs"
            },
            {
              "method": "GET",
              "status": 401,
              "url": "http://reference.test/v1/projects/proj_alpha/jobs"
            }
          ],
          "summary": "an operation refused a credential one of its documented alternatives accepts",
          "verdict": "BACKEND_BUG"
        },
        {
          "check": "auth.alternative-accepted",
          "detail": "row.get answered 401 to alpha's apiKey credential, though the document accepts apiKey with row:read on its own. The same request with jwt answered 200.",
