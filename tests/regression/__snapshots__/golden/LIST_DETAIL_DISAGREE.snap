    "findings": {
      "added": [
        {
          "check": "consistency.projections-agree",
          "detail": "job job_ID has \"name\" = \"Quarterly Report 0\" on the record oat created, but the collection returns \"Quarterly Report 0 (listing)\", and the sparse fieldset returns \"Quarterly Report 0 (listing)\", and the sorted page returns \"Quarterly Report 0 (listing)\". At least one read path is serving something the others are not; a client's view of a record then depends on which route it happened to use.",
          "entity": "job",
          "operations": [
            "job.get",
            "job.list"
          ],
          "evidence": [
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_alpha/jobs/job_ID"
            },
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_alpha/jobs?limit=100"
            }
          ],
          "summary": "the same record carries different values depending on how it is read",
          "verdict": "BACKEND_BUG"
        },
        {
          "check": "schema.read-response-matches-document",
          "detail": "job.list returned 200 with a body that fails the declared schema: /jobs/0/name must NOT have more than 128 characters. Either the handler answers other than it promises or the document is out of date — both break generated clients.",
          "entity": "job",
          "operations": [
            "job.list"
          ],
          "evidence": [
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_alpha/jobs?limit=100&page=1"
            }
          ],
          "summary": "job.list answered a body its documented schema does not describe",
          "verdict": "SPEC_BUG"
        },
        {
          "check": "schema.read-response-matches-document",
          "detail": "table.list returned 200 with a body that fails the declared schema: /tables/0/name must NOT have more than 128 characters. Either the handler answers other than it promises or the document is out of date — both break generated clients.",
          "entity": "table",
          "operations": [
            "table.list"
          ],
          "evidence": [
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_alpha/tables?limit=100&page=1"
            }
          ],
          "summary": "table.list answered a body its documented schema does not describe",
          "verdict": "SPEC_BUG"
        }
      ]
    },
