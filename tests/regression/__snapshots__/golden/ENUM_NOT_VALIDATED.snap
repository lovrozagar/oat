    "findings": {
      "added": [
        {
          "check": "schema.read-response-matches-document",
          "detail": "job.list returned 200 with a body that fails the declared schema: /jobs/8/kind must be equal to one of the allowed values. Either the handler answers other than it promises or the document is out of date — both break generated clients.",
          "entity": "job",
          "operations": [
            "job.list"
          ],
          "evidence": [
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_alpha/jobs?limit=100&page=1"
            }
          ],
          "summary": "job.list answered a body its documented schema does not describe",
          "verdict": "SPEC_BUG"
        },
        {
          "check": "validation.enum-enforced",
          "detail": "\"kind\" declares [\"export\", \"import\", \"sync\"] but the backend accepted \"oat-not-in-enum\" with 201. Clients generated from this document will assume the field only ever holds a declared member.",
          "entity": "job",
          "operations": [
            "job.create"
          ],
          "evidence": [
            {
              "method": "POST",
              "status": 201,
              "url": "http://reference.test/v1/projects/proj_alpha/jobs"
            }
          ],
          "summary": "a value outside the declared enum was accepted",
          "verdict": "BACKEND_BUG"
        },
        {
          "check": "validation.enum-enforced",
          "detail": "\"status\" declares [\"active\", \"draft\", \"archived\"] but the backend accepted \"oat-not-in-enum\" with 201. Clients generated from this document will assume the field only ever holds a declared member.",
          "entity": "table",
          "operations": [
            "table.create"
          ],
          "evidence": [
            {
              "method": "POST",
              "status": 201,
              "url": "http://reference.test/v1/projects/proj_alpha/tables"
            }
          ],
          "summary": "a value outside the declared enum was accepted",
          "verdict": "BACKEND_BUG"
        },
        {
          "check": "validation.enum-enforced",
          "detail": "\"status\" declares [\"active\", \"paused\"] but the backend accepted \"oat-not-in-enum\" with 201. Clients generated from this document will assume the field only ever holds a declared member.",
          "entity": "webhook",
          "operations": [
            "webhook.create"
          ],
          "evidence": [
            {
              "method": "POST",
              "status": 201,
              "url": "http://reference.test/v1/projects/proj_alpha/webhooks"
            }
          ],
          "summary": "a value outside the declared enum was accepted",
          "verdict": "BACKEND_BUG"
        }
      ]
