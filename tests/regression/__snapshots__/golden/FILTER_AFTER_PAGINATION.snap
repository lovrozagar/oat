    "findings": {
      "added": [
        {
          "check": "query.filter-selects-from-whole-set",
          "detail": "walking the collection at 1 per page and filtering client-side on \"active\" = true finds 4 record(s); asking the backend for the same filter returns 1. Never returned: row_ID, row_ID, row_ID. The page window is being computed before the predicate is applied, so matching records fall outside it and are lost — page one looks correct and later pages silently omit data.",
          "entity": "row",
          "operations": [
            "row.list"
          ],
          "evidence": [
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_alpha/tables/table_ID/rows?limit=1&order=id.asc&filter=active.eq.true&page=2"
            },
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_alpha/tables/table_ID/rows?limit=1&order=id.asc&page=8"
            }
          ],
          "summary": "paging a filtered query skips records that match the filter",
          "verdict": "BACKEND_BUG"
        },
        {
          "check": "query.filter-selects-from-whole-set",
          "detail": "walking the collection at 1 per page and filtering client-side on \"kind\" = \"export\" finds 3 record(s); asking the backend for the same filter returns 1. Never returned: job_ID, job_ID. The page window is being computed before the predicate is applied, so matching records fall outside it and are lost — page one looks correct and later pages silently omit data.",
          "entity": "job",
          "operations": [
            "job.list"
          ],
          "evidence": [
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_alpha/jobs?limit=1&order=id.asc&filter=kind.eq.export&page=2"
            },
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_alpha/jobs?limit=1&order=id.asc&page=8"
            }
          ],
          "summary": "paging a filtered query skips records that match the filter",
          "verdict": "BACKEND_BUG"
        },
        {
          "check": "query.filter-selects-from-whole-set",
          "detail": "walking the collection at 1 per page and filtering client-side on \"status\" = \"active\" finds 5 record(s); asking the backend for the same filter returns 3. Never returned: table_ID, table_ID. The page window is being computed before the predicate is applied, so matching records fall outside it and are lost — page one looks correct and later pages silently omit data.",
          "entity": "table",
          "operations": [
            "table.list"
          ],
          "evidence": [
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_alpha/tables?limit=1&order=id.asc&filter=status.eq.active&page=4"
            },
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_alpha/tables?limit=1&order=id.asc&page=10"
            }
          ],
          "summary": "paging a filtered query skips records that match the filter",
          "verdict": "BACKEND_BUG"
        }
      ]
    },
