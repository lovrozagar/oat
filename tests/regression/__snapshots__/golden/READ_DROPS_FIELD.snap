    "findings": {
      "added": [
        {
          "check": "consistency.projections-agree",
          "detail": "table table_ID has \"description\" = undefined on the record oat created, but the collection returns \"Quarterly Report 0\", and the sparse fieldset returns \"Quarterly Report 0\", and the sorted page returns \"Quarterly Report 0\". At least one read path is serving something the others are not; a client's view of a record then depends on which route it happened to use.",
          "entity": "table",
          "operations": [
            "table.get",
            "table.list"
          ],
          "evidence": [
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_alpha/tables/table_ID"
            },
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_alpha/tables?limit=100"
            }
          ],
          "summary": "the same record carries different values depending on how it is read",
          "verdict": "BACKEND_BUG"
        },
        {
          "check": "payload.string-survives",
          "detail": "\"description\" was sent \"oat-payload-NONCE\" and read back undefined.",
          "entity": "table",
          "operations": [
            "table.get",
            "table.update"
          ],
          "evidence": [
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_alpha/tables/table_ID"
            },
            {
              "method": "PATCH",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_alpha/tables/table_ID"
            }
          ],
          "summary": "an ordinary ASCII write did not persist exactly",
          "verdict": "BACKEND_BUG"
        }
      ],
      "removed": [
        {
          "check": "payload.string-survives",
          "detail": "the whole catalog already ran against this write path on job, so this field got one case of each family. Set `payloads: \"full\"` to send every case to every field.",
          "entity": "table",
          "operations": [
            "table.get",
            "table.update"
          ],
          "evidence": [],
          "summary": "12 of 159 payload cases sent to \"description\"",
          "verdict": "COVERAGE_GAP"
        }
      ]
    },
    "summary": {
      "COVERAGE_GAP": {
        "now": 1,
        "was": 2
      },
      "BACKEND_BUG": {
        "now": 2,
