    "findings": {
      "added": [
        {
          "check": "query.search-and-filter-compose",
          "detail": "filter on \"status\" matched 14; q=\"a7a7a7a7\" matched 16; both together matched 13 (intersection is 12). Extra: table_ID. A structured predicate and a free-text search must narrow each other. When they do not, one of them is being dropped the moment the other is present.",
          "entity": "table",
          "operations": [
            "table.list"
          ],
          "evidence": [
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_alpha/tables?limit=100&filter=status.eq.active&page=1"
            },
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_alpha/tables?limit=100&filter=status.eq.active&q=a7a7a7a7&page=1"
            },
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_alpha/tables?limit=100&q=a7a7a7a7&page=1"
            }
          ],
          "summary": "a filter and a search do not compose as their intersection",
          "verdict": "BACKEND_BUG"
        },
        {
          "check": "tenant.filter-does-not-bypass-scope",
          "detail": "a principal in another tenant filtered on id.eq.job_ID and received the record. The tenant predicate is applied to the base listing but not re-applied to filter matches, so any caller who can guess an id can read it. The list declares x-tenant: \"project_id\", so this crosses a boundary the document states exists.",
          "entity": "job",
          "operations": [
            "job.list"
          ],
          "evidence": [
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_beta/jobs?limit=100&filter=id.eq.job_ID"
            }
          ],
          "summary": "a filter reaches records outside the caller's tenant",
          "verdict": "SECURITY"
        },
        {
          "check": "tenant.filter-does-not-bypass-scope",
          "detail": "a principal in another tenant filtered on id.eq.row_ID and received the record. The tenant predicate is applied to the base listing but not re-applied to filter matches, so any caller who can guess an id can read it. The list declares x-tenant: \"project_id\", so this crosses a boundary the document states exists.",
          "entity": "row",
          "operations": [
            "row.list"
          ],
          "evidence": [
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_beta/tables/table_ID/rows?limit=5&filter=id.eq.row_ID"
            }
          ],
          "summary": "a filter reaches records outside the caller's tenant",
          "verdict": "SECURITY"
        },
        {
          "check": "tenant.filter-does-not-bypass-scope",
          "detail": "a principal in another tenant filtered on id.eq.table_ID and received the record. The tenant predicate is applied to the base listing but not re-applied to filter matches, so any caller who can guess an id can read it. The list declares x-tenant: \"project_id\", so this crosses a boundary the document states exists.",
          "entity": "table",
          "operations": [
            "table.list"
          ],
          "evidence": [
            {
              "method": "GET",
              "status": 200,
              "url": "http://reference.test/v1/projects/proj_beta/tables?limit=100&filter=id.eq.table_ID"
            }
          ],
          "summary": "a filter reaches records outside the caller's tenant",
          "verdict": "SECURITY"
        }
      ]
