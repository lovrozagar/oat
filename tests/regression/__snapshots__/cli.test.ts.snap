// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CLI golden > --help 1`] = `
{
  "code": 0,
  "output": "oat — OpenAPI Tester

  oat run     --config <file>                  test a live backend and write a report
  oat plan    --spec <url|file>                derive and print the test model (offline)
  oat doctor  --spec <url|file>                report what oat can and cannot test, and why
  oat init    --spec <url|file> [--out file]   write a starter oat.config.ts from the document's security schemes
  oat serve   [--defects A,B]                  run a demo API to point oat at
  oat conformance                              self-test: injected defects vs detection
  oat baseline --from <run> [--out file]       write a known-findings baseline from a run's report
  oat diff    <runA> <runB> [--json]           new, fixed and persisting findings between two runs

Flags
  --config <file>         oat config module (.ts/.js/.mjs/.json) with a default export
  --spec <url|file>       OpenAPI document, http(s) URL or filesystem path
  --base-url <url>        backend under test, overriding the config
  --ops <ids>             comma-separated operationIds to grade (row.*, cdn:asset.get); the rest is support
  --only <names>          run, plan: comma-separated entities, each grading every operation it owns; conformance: defect names
  --profile <name>        named profile gating which operations run (built-in: full, cheap)
  --seed <n>              integer seed for fixture generation (default 1); with --fuzz or --precision, the seed that replays a case
  --out <dir|file>        run: history root, each run is <out>/<datetime>/ (default ./.oat/runs); baseline: the file written; init: the config written (default ./oat.config.ts)
  --report <names>        run: comma-separated reports to write beside the run's own; junit writes junit.xml in the run directory
  --keep-fixtures         leave created records in place instead of tearing them down
  --keep-credentials      write the credentials the run held to .oat/credentials.json (mode 0600), never under --out
  --max-in-flight <n>     requests allowed in flight at once (default 4)
  --quiet                 no live progress on stderr (progress.log still written)
  --save-exchanges        persist every HTTP exchange under the run dir (default unless --profile cheap)
  --no-save-exchanges     skip the exchange journal (cheap CI)
  --untagged              serve (or test) a document with every x-* tag stripped
  --defects <names>       serve: comma-separated defects the demo API injects
  --backend <name>        conformance and serve storage: memory | sqlite | postgres | d1 (default: all local; d1 is remote and opt-in)
  --dialect <name>        API shape: postgrest | classic | linked | jsonapi | plain | template (default: all)
  --parser                conformance: the document and suite checks only, without the defect matrix
  --fuzz [n]              conformance: inject random defect combinations instead of one at a time
  --precision [n]         conformance: vary cohort data against a correct backend; any finding is a false positive
  --max-defects <n>       conformance: most defects per combination (default 4)
  --fuzz-seed <n>         conformance: seed for the combination pass of a full run (default 1)
  --jobs <n>              conformance: legs run at once, each on its own thread (default: CPUs − 1, at most 4)
  --skip-backend <names>  conformance: comma-separated backends a full run may leave out when unreachable
  --legs <legs>           conformance: run only these parts — suites, passes, shapes, recall, scope, fuzz
  --shapes <names>        conformance: the shapes the shapes and recall legs judge behind; all when absent
  --proven-out <file>     conformance: write the checks this run's defects proved to a file, for --aggregate
  --aggregate <dir>       conformance: judge the proven-check files of a sharded run together; fails on any check none proved
  --json                  machine-readable output, for plan, doctor and diff
  --from <run>            baseline: the run folder (or latest) whose findings become known
  --force                 baseline, init: overwrite an existing --out file
  --help                  print this help
",
}
`;

exports[`CLI golden > baseline from a missing run 1`] = `
{
  "code": 2,
  "output": "oat: cannot read <dir>/no-run/oat-report.json: ENOENT: no such file or directory, realpath '<dir>/no-run'
",
}
`;

exports[`CLI golden > baseline from a report with no findings 1`] = `
{
  "code": 2,
  "output": "oat: <dir>/empty-run/oat-report.json holds no findings list
",
}
`;

exports[`CLI golden > baseline over an existing file 1`] = `
{
  "code": 2,
  "output": "oat: <dir>/existing.json exists; --force overwrites it
",
}
`;

exports[`CLI golden > baseline without --from 1`] = `
{
  "code": 2,
  "output": "oat: baseline needs --from <run folder | latest>
",
}
`;

exports[`CLI golden > boolean flag given a value 1`] = `
{
  "code": 2,
  "output": "oat: --quiet takes no value

oat — OpenAPI Tester

  oat run     --config <file>                  test a live backend and write a report
  oat plan    --spec <url|file>                derive and print the test model (offline)
  oat doctor  --spec <url|file>                report what oat can and cannot test, and why
  oat init    --spec <url|file> [--out file]   write a starter oat.config.ts from the document's security schemes
  oat serve   [--defects A,B]                  run a demo API to point oat at
  oat conformance                              self-test: injected defects vs detection
  oat baseline --from <run> [--out file]       write a known-findings baseline from a run's report
  oat diff    <runA> <runB> [--json]           new, fixed and persisting findings between two runs

Flags
  --config <file>         oat config module (.ts/.js/.mjs/.json) with a default export
  --spec <url|file>       OpenAPI document, http(s) URL or filesystem path
  --base-url <url>        backend under test, overriding the config
  --ops <ids>             comma-separated operationIds to grade (row.*, cdn:asset.get); the rest is support
  --only <names>          run, plan: comma-separated entities, each grading every operation it owns; conformance: defect names
  --profile <name>        named profile gating which operations run (built-in: full, cheap)
  --seed <n>              integer seed for fixture generation (default 1); with --fuzz or --precision, the seed that replays a case
  --out <dir|file>        run: history root, each run is <out>/<datetime>/ (default ./.oat/runs); baseline: the file written; init: the config written (default ./oat.config.ts)
  --report <names>        run: comma-separated reports to write beside the run's own; junit writes junit.xml in the run directory
  --keep-fixtures         leave created records in place instead of tearing them down
  --keep-credentials      write the credentials the run held to .oat/credentials.json (mode 0600), never under --out
  --max-in-flight <n>     requests allowed in flight at once (default 4)
  --quiet                 no live progress on stderr (progress.log still written)
  --save-exchanges        persist every HTTP exchange under the run dir (default unless --profile cheap)
  --no-save-exchanges     skip the exchange journal (cheap CI)
  --untagged              serve (or test) a document with every x-* tag stripped
  --defects <names>       serve: comma-separated defects the demo API injects
  --backend <name>        conformance and serve storage: memory | sqlite | postgres | d1 (default: all local; d1 is remote and opt-in)
  --dialect <name>        API shape: postgrest | classic | linked | jsonapi | plain | template (default: all)
  --parser                conformance: the document and suite checks only, without the defect matrix
  --fuzz [n]              conformance: inject random defect combinations instead of one at a time
  --precision [n]         conformance: vary cohort data against a correct backend; any finding is a false positive
  --max-defects <n>       conformance: most defects per combination (default 4)
  --fuzz-seed <n>         conformance: seed for the combination pass of a full run (default 1)
  --jobs <n>              conformance: legs run at once, each on its own thread (default: CPUs − 1, at most 4)
  --skip-backend <names>  conformance: comma-separated backends a full run may leave out when unreachable
  --legs <legs>           conformance: run only these parts — suites, passes, shapes, recall, scope, fuzz
  --shapes <names>        conformance: the shapes the shapes and recall legs judge behind; all when absent
  --proven-out <file>     conformance: write the checks this run's defects proved to a file, for --aggregate
  --aggregate <dir>       conformance: judge the proven-check files of a sharded run together; fails on any check none proved
  --json                  machine-readable output, for plan, doctor and diff
  --from <run>            baseline: the run folder (or latest) whose findings become known
  --force                 baseline, init: overwrite an existing --out file
  --help                  print this help
",
}
`;

exports[`CLI golden > conformance --only with an unknown defect 1`] = `
