{
	"name": "@lovrozagar/oat",
	"version": "0.26.0",
	"description": "OpenAPI Tester — matrix-test a live API against its OpenAPI spec",
	"keywords": [
		"api",
		"contract-testing",
		"openapi",
		"swagger",
		"testing"
	],
	"homepage": "https://github.com/lovrozagar/oat#readme",
	"bugs": {
		"url": "https://github.com/lovrozagar/oat/issues"
	},
	"license": "MIT",
	"author": "lovrozagar",
	"repository": {
		"type": "git",
		"url": "https://github.com/lovrozagar/oat.git"
	},
	"bin": {
		"oat": "./bin/oat.js"
	},
	"files": [
		"bin/oat.js",
		"dist",
		"!dist/**/*.map",
		"README.md",
		"docs",
		"LICENSE",
		"labs/annotated-openapi.yaml",
		"labs/local.config.ts",
		"labs/minimal.config.ts",
		"labs/oob-auth.config.ts",
		"labs/demo.mjs",
		"labs/README.md"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"bisect": "node labs/bisect.mjs",
		"build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
		"check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
		"conformance": "node dist/cli.js conformance",
		"conformance:sharded": "bun scripts/conformance-sharded.ts",
		"demo": "bun run build && node labs/demo.mjs",
		"dev": "tsc -p tsconfig.json --watch",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"grunt:antigravity": "antigravity --dangerously-skip-permissions",
		"grunt:claude": "claude --dangerously-skip-permissions",
		"grunt:codex": "codex --dangerously-bypass-approvals-and-sandbox",
		"grunt:doctor": "node ./.rulesync/scripts/doctor.mjs",
		"grunt:gemini": "gemini --yolo",
		"grunt:grok": "grok --yolo",
		"grunt:hooks:check": "node .rulesync/scripts/hooks-union.mjs --check",
		"grunt:hooks:union": "node .rulesync/scripts/hooks-union.mjs",
		"grunt:purge:global-mcps": "node .rulesync/scripts/purge-global-mcps.mjs",
		"grunt:purge:global-mcps:apply": "node .rulesync/scripts/purge-global-mcps.mjs --apply",
		"grunt:rulesync:check": "node ./.rulesync/scripts/guarded-roots.mjs check",
		"grunt:rulesync:doctor": "rulesync doctor",
		"grunt:rulesync:generate": "node ./.rulesync/scripts/guarded-roots.mjs generate",
		"grunt:rulesync:watch": "node ./.rulesync/scripts/guarded-roots.mjs watch",
		"grunt:setup": "node ./.rulesync/scripts/setup.mjs",
		"grunt:sync:globals": "node .rulesync/scripts/sync-global-settings.mjs",
		"grunt:sync:globals:apply": "node .rulesync/scripts/sync-global-settings.mjs --apply",
		"grunt:sync:globals:check": "node .rulesync/scripts/check-globals.mjs",
		"labs": "node labs/serve.ts",
		"labs:sweep": "bash labs/sweep.sh",
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --fix",
		"prepare": "lefthook install --reset-hooks-path",
		"prepublishOnly": "bun run build",
		"test": "bun run build && bun run test:unit && bun run test:integration && node dist/cli.js conformance",
		"test:e2e": "bun run build && vitest run -c vitest.e2e.config.ts",
		"test:integration": "vitest run --project integration",
		"test:targets": "vitest run -c vitest.targets.config.ts",
		"test:unit": "vitest run --project unit --coverage",
		"typecheck": "bun run check",
		"verify": "bun scripts/verify.ts"
	},
	"dependencies": {
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@clack/prompts": "^0.11.0",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@lovrozagar/grunt": "0.12.0",
		"@types/node": "^22.10.0",
		"@vitest/coverage-v8": "4.1.10",
		"fast-check": "4.10.2",
		"lefthook": "2.2.2",
		"oxc-parser": "0.152.0",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"postgres": "^3.4.9",
		"rulesync": "16.17.0",
		"smol-toml": "^1.8.0",
		"typescript": "^5.7.2",
		"vitest": "4.1.10"
	},
	"peerDependencies": {
		"postgres": "^3.4"
	},
	"peerDependenciesMeta": {
		"postgres": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"packageManager": "bun@1.3.11",
	"standards": {
		"repo": "oat",
		"gates": [
			"test:integration",
			"test:e2e"
		]
	}
}
