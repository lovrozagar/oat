{
  "name": "oat",
  "version": "0.0.0",
  "description": "OpenAPI Tester — deep behavioural testing of any backend against its OpenAPI specification",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "oat": "./dist/cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "README.md", "EXTENSIONS.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'"
  },
  "keywords": ["openapi", "testing", "contract-testing", "api", "swagger"],
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
