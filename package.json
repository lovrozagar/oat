{
	"name": "@lovrozagar/oat",
	"version": "0.1.1",
	"description": "OpenAPI Tester — behavioural testing of a live backend against its OpenAPI specification",
	"keywords": [
		"api",
		"contract-testing",
		"openapi",
		"swagger",
		"testing"
	],
	"homepage": "https://github.com/lovrozagar/oat#readme",
	"bugs": {
		"url": "https://github.com/lovrozagar/oat/issues"
	},
	"license": "MIT",
	"author": "lovrozagar",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lovrozagar/oat.git"
	},
	"bin": {
		"oat": "./bin/oat.js"
	},
	"files": [
		"bin/oat.js",
		"dist/cli.js",
		"dist/index.js",
		"dist/index.d.ts",
		"dist/config",
		"dist/reference",
		"dist/report",
		"dist/runtime",
		"dist/spec",
		"README.md",
		"LICENSE",
		"labs/annotated-openapi.yaml",
		"labs/local.config.ts",
		"labs/minimal.config.ts",
		"labs/anyrow.config.ts",
		"labs/demo.mjs",
		"labs/README.md"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"dev": "tsc -p tsconfig.json --watch",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "npm run build && node --experimental-sqlite dist/cli.js conformance",
		"conformance": "node --experimental-sqlite dist/cli.js conformance",
		"demo": "npm run build && node labs/demo.mjs",
		"labs": "node --experimental-strip-types labs/serve.ts",
		"labs:sweep": "bash labs/sweep.sh",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"postgres": "^3.4.9",
		"typescript": "^5.7.2"
	},
	"engines": {
		"node": ">=20"
	}
}
