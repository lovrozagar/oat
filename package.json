{
  "name": "@lovrozagar/oat",
  "version": "0.12.9",
  "description": "OpenAPI Tester — matrix-test a live API against its OpenAPI spec",
  "keywords": [
    "api",
    "contract-testing",
    "openapi",
    "swagger",
    "testing"
  ],
  "homepage": "https://github.com/lovrozagar/oat#readme",
  "bugs": {
    "url": "https://github.com/lovrozagar/oat/issues"
  },
  "license": "MIT",
  "author": "lovrozagar",
  "repository": {
    "type": "git",
    "url": "https://github.com/lovrozagar/oat.git"
  },
  "bin": {
    "oat": "./bin/oat.js"
  },
  "files": [
    "bin/oat.js",
    "dist/cli.js",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/config",
    "dist/conformance",
    "dist/reference",
    "dist/report",
    "dist/runtime",
    "dist/spec",
    "README.md",
    "docs",
    "LICENSE",
    "labs/annotated-openapi.yaml",
    "labs/local.config.ts",
    "labs/minimal.config.ts",
    "labs/oob-auth.config.ts",
    "labs/demo.mjs",
    "labs/README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bisect": "node --experimental-sqlite labs/bisect.mjs",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "conformance": "node --experimental-sqlite dist/cli.js conformance",
    "demo": "bun run build && node labs/demo.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "grunt:antigravity": "antigravity --dangerously-skip-permissions",
    "grunt:claude": "claude --dangerously-skip-permissions",
    "grunt:codex": "codex --dangerously-bypass-approvals-and-sandbox",
    "grunt:doctor": "node ./scripts/doctor.mjs",
    "grunt:gemini": "gemini --yolo",
    "grunt:grok": "grok --yolo",
    "grunt:hooks:check": "node scripts/hooks-union.mjs --check",
    "grunt:hooks:union": "node scripts/hooks-union.mjs",
    "grunt:purge:global-mcps": "node scripts/purge-global-mcps.mjs",
    "grunt:purge:global-mcps:apply": "node scripts/purge-global-mcps.mjs --apply",
    "grunt:rulesync:check": "node ./scripts/guarded-roots.mjs check",
    "grunt:rulesync:doctor": "rulesync doctor",
    "grunt:rulesync:generate": "node ./scripts/guarded-roots.mjs generate",
    "grunt:rulesync:watch": "node ./scripts/guarded-roots.mjs watch",
    "grunt:setup": "node ./scripts/setup.mjs",
    "grunt:sync:globals": "node scripts/sync-global-settings.mjs",
    "grunt:sync:globals:apply": "node scripts/sync-global-settings.mjs --apply",
    "grunt:sync:globals:check": "node scripts/check-globals.mjs",
    "labs": "node --experimental-strip-types labs/serve.ts",
    "labs:sweep": "bash labs/sweep.sh",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "git config --get core.hooksPath >/dev/null || git config core.hooksPath .githooks || true",
    "prepublishOnly": "bun run build",
    "test": "bun run build && bun run test:unit && node --experimental-sqlite dist/cli.js conformance",
    "test:unit": "vitest run --coverage"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@lovrozagar/grunt": "0.10.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "4.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "postgres": "^3.4.9",
    "rulesync": "16.17.0",
    "smol-toml": "^1.8.0",
    "typescript": "^5.7.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.11"
}
