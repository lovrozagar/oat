{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 120,
	"useTabs": true,
	"semi": false,
	"singleQuote": false,
	/* Agent tooling is generated by its own sync, not oat source. */
	"ignorePatterns": [
		"dist/**",
		"coverage/**",
		"oat-out/**",
		"labs/node_modules/**",
		"labs/schema/**",
		"*.lock",
		".agents/**",
		".claude/**",
		".codex/**",
		".gemini/**",
		".grok/**",
		".rulesync/**",
		".mcp.json",
	],
}
