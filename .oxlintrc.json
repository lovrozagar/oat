{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"extends": ["./oxlint.base.json"],
	"plugins": ["typescript", "unicorn", "oxc"],
	"jsPlugins": ["./lint/oat.oxlint-plugin.ts"],
	"env": {
		"node": true
	},
	"ignorePatterns": [
		"dist/**",
		"coverage/**",
		"oat-out/**",
		".oat/**",
		"labs/node_modules/**",
		"labs/schema/**",
		".agents/**",
		".claude/**",
		".codex/**",
		".gemini/**",
		".grok/**",
		".rulesync/**"
	],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"rules": {
		"no-unused-vars": "warn",
		"oat/exit-only-in-cli": "error",
		"oat/grammar-through-renderer": "error",
		"oat/id-through-reader": "error",
		"oat/network-through-client": "error",
		"oat/proven-id-origin": "error",
		"unicorn/no-array-sort": "off",
		"unicorn/prefer-string-starts-ends-with": "warn"
	},
	"overrides": [
		{
			"files": ["labs/**/*.{ts,mjs,js}"],
			"rules": {
				"typescript/no-explicit-any": "off"
			}
		}
	]
}
