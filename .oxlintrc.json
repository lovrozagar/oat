{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"env": {
		"node": true
	},
	"ignorePatterns": ["dist/**", "coverage/**", "oat-out/**", ".oat/**", "labs/node_modules/**", "labs/schema/**"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"rules": {
		"no-unused-vars": "warn",
		"unicorn/no-array-sort": "off",
		"unicorn/prefer-string-starts-ends-with": "warn"
	},
	"overrides": [
		{
			"files": ["labs/**/*.{ts,mjs,js}"],
			"rules": {
				"typescript/no-explicit-any": "off"
			}
		}
	]
}
