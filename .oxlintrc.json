{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"extends": ["./oxlint.base.json"],
	"plugins": ["typescript", "unicorn", "oxc"],
	"jsPlugins": [{ "name": "oat", "specifier": "./lint/index.ts" }],
	"env": {
		"node": true
	},
	"ignorePatterns": [
		"dist/**",
		"coverage/**",
		"oat-out/**",
		".oat/**",
		"labs/node_modules/**",
		"labs/schema/**",
		".agents/**",
		".claude/**",
		".codex/**",
		".gemini/**",
		".grok/**",
		".rulesync/**"
	],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"rules": {
		"no-unused-vars": "warn",
		"oat/exit-only-in-cli": "error",
		"oat/grammar-through-renderer": "error",
		"oat/id-through-reader": "error",
		"oat/network-through-client": "error",
		"oat/proven-id-origin": "error",
		"unicorn/no-array-sort": "off",
		"unicorn/prefer-string-starts-ends-with": "warn"
	},
	"overrides": [
		{
			"files": ["labs/**/*.{ts,mjs,js}"],
			"rules": {
				"typescript/no-explicit-any": "off"
			}
		},
		{
			"files": [
				"lint/**",
				"src/cli/**",
				"src/config/env.ts",
				"src/config/types/**",
				"src/config/validate/**",
				"src/conformance/harness/**",
				"src/credentials/**",
				"src/errors/**",
				"src/runtime/checks/**",
				"src/security/**",
				"src/spec/security/**"
			],
			"plugins": ["typescript", "unicorn", "oxc", "vitest"],
			"rules": {
				"complexity": ["error", 15],
				"max-depth": ["error", 4],
				"max-lines": ["error", 300],
				"max-lines-per-function": ["error", 60],
				"max-params": ["error", 4],
				"unicorn/consistent-function-scoping": "error",
				"vitest/expect-expect": "error",
				"vitest/no-conditional-expect": "error",
				"vitest/no-disabled-tests": "error",
				"vitest/no-focused-tests": "error",
				"oat/boundaries": "error",
				"oat/index-purity": "error",
				"oat/no-console": "error",
				"oat/no-header-branching": "error",
				"oat/no-module-side-effects": "error",
				"oat/no-module-state": "error",
				"oat/no-v8-ignore": "error"
			}
		},
		{
			"files": ["src/**"],
			"rules": {
				"oat/boundaries": "error",
				"oat/index-purity": "error"
			}
		},
		{
			"files": [
				"lint/**/*.test.ts",
				"src/cli/**/*.test.ts",
				"src/errors/**/*.test.ts",
				"src/config/validate/**/*.test.ts",
				"src/credentials/**/*.test.ts",
				"src/runtime/checks/**/*.test.ts",
				"src/security/**/*.test.ts",
				"src/spec/security/**/*.test.ts"
			],
			"rules": {
				"max-lines": ["error", 500]
			}
		}
	]
}
